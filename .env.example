# Gemma-claim 환경변수 템플릿
# 이 파일을 .env 로 복사한 뒤 값만 채우세요. .env 는 .gitignore 에 있어 커밋되지 않습니다.
#   cp .env.example .env

# ── 추론 서빙 (serving/claim_chat.py, claim_client.py, claim_batch.py) ──
# RunPod (기본 provider). 대시보드 > Settings > API Keys 에서 발급.
RUNPOD_API_KEY=
# 생략하면 스크립트 기본값 fdiltabt78bogm 을 씁니다.
RUNPOD_ENDPOINT_ID=fdiltabt78bogm

# DeepInfra (--provider deepinfra 로 쓸 때만 필요). deepinfra.com 대시보드에서 발급.
DEEPINFRA_TOKEN=

# ── Hub 업로드 (pipeline/push_hub.py) ──
# write 권한이 있는 Hugging Face 토큰. push_hub.py 를 돌릴 때만 필요합니다.
HF_TOKEN=
# 생략하면 토큰의 계정 이름을 씁니다.
#HF_USER=
#HF_ADAPTER_REPO=
#HF_MERGED_REPO=
#HF_PRIVATE=1

# ── 그 밖의 선택 항목 ──
#BASE_MODEL=google/gemma-4-31B-it
#BASE_MODEL_REVISION=main
#DATASET_URL=
#DRIVE_FILE_ID=11sk-Ol6p01xT7eC-ktjaI0I4VXnFGedv
